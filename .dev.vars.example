APP_URL=http://127.0.0.1:5173
SESSION_TRANSPORT=bearer
# Open only for controlled testing or an explicitly approved public launch.
REGISTRATION_OPEN=false
# Separate administrator access. Generate with `npm run admin:key`; store only the SHA-256 here or as a Worker secret.
# Leave blank to keep the admin workspace closed.
ADMIN_KEY_SHA256=
# Email accounts: generate at least 32 random bytes; never put secrets in VITE_* variables.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# Resend sending-only key scoped to your verified domain; leave blank to disable registration/recovery.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: mirror issue reports to GitHub issues (fine-grained token, Issues: read and write on one repository).
# Leave blank to keep reports in the admin inbox only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=repeat98/octamod
# Secret of the repository webhook (Issues events) that syncs closed/reopened status back to reporters.
GITHUB_WEBHOOK_SECRET=
